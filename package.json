{
  "name": "hellozenmcp",
  "version": "1.0.0",
  "private": true,
  "description": "An unofficial, self-hosted, strictly read-only MCP connector designed for inspecting HelloZen configuration.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:hellozen": "tsx src/cli/verify-hellozen.ts",
    "session:status": "scripts/hellozen-session status",
    "session:start": "scripts/hellozen-session start",
    "session:stop": "scripts/hellozen-session stop",
    "session:doctor": "scripts/hellozen-session doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
