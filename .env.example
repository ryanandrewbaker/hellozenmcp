# HelloZen Private Integration token with read-only scopes only.
# Create a dedicated integration — never reuse write-capable credentials.
HELLOZEN_MCP_READONLY_TOKEN=

# HelloZen sub-account location ID (letters, numbers, underscore, hyphen only).
HELLOZEN_MCP_LOCATION_ID=

# Optional company ID for GET /users/search when required by token scope.
HELLOZEN_MCP_COMPANY_ID=

HELLOZEN_MCP_PORT=8790
HELLOZEN_MCP_BIND_HOST=0.0.0.0
HELLOZEN_MCP_REQUEST_TIMEOUT_MS=10000
HELLOZEN_MCP_CACHE_TTL_SECONDS=60

# Docker host publish address (left side of ports: mapping). Default loopback only.
# On a trusted-LAN deployment host (e.g. Vision), set to the host private LAN IP so
# Cursor on another machine and tunnel-client on the same host share one endpoint:
#   HELLOZEN_MCP_PUBLISH_HOST=192.168.50.234
# Do not use 0.0.0.0. Do not port-forward TCP 8790 to the Internet.
HELLOZEN_MCP_PUBLISH_HOST=127.0.0.1
