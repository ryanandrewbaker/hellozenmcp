# HelloZen Private Integration token with read-only scopes only.
# Create a dedicated integration — never reuse write-capable credentials.
HELLOZEN_MCP_READONLY_TOKEN=

# HelloZen sub-account location ID (letters, numbers, underscore, hyphen only).
HELLOZEN_MCP_LOCATION_ID=

HELLOZEN_MCP_PORT=8790
HELLOZEN_MCP_BIND_HOST=0.0.0.0
HELLOZEN_MCP_REQUEST_TIMEOUT_MS=10000
HELLOZEN_MCP_CACHE_TTL_SECONDS=60

# --- OAuth resource server (required for v1.1 production) ---
# Protects /mcp with bearer access tokens from your external OAuth/OIDC provider.
HELLOZEN_MCP_AUTH_ENABLED=true

# Canonical public MCP resource identity (used for protected-resource metadata and audience validation).
# Example: https://mcp.example.com/mcp
HELLOZEN_MCP_RESOURCE_URL=

# External OAuth/OIDC authorization server issuer URL.
# Example: https://auth.example.com
HELLOZEN_MCP_OAUTH_ISSUER=

# Access-token audience/resource identifier. Defaults to HELLOZEN_MCP_RESOURCE_URL when omitted.
HELLOZEN_MCP_OAUTH_AUDIENCE=

# Required MCP scope for all tools in v1.1.
HELLOZEN_MCP_REQUIRED_SCOPE=hellozen.read

# Optional JWKS override when discovery metadata does not publish jwks_uri.
HELLOZEN_MCP_OAUTH_JWKS_URI=

# Test/development only — never set in production.
# HELLOZEN_MCP_AUTH_ENABLED=false requires this explicit second gate.
# HELLOZEN_MCP_ALLOW_AUTH_DISABLED=true

# --- Cloudflare Tunnel (optional external HTTPS ingress) ---
# Remotely managed tunnel token — never commit real values.
# Start with: docker compose -f compose.yml -f compose.cloudflare.yml --profile cloudflare up -d
# Configure the Cloudflare tunnel public hostname to route to http://hellozen-mcp:8790
CLOUDFLARE_TUNNEL_TOKEN=
