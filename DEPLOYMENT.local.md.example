# Copy to DEPLOYMENT.local.md (gitignored) for operator-specific notes.
# Do not commit real credentials, domains, or personal identifiers.

# Vision deployment path:
# /mnt/user/devconcepts/hellozenmcp
#
# Create .env on Vision only (never in Git):
# /mnt/user/devconcepts/hellozenmcp/.env
#
# Trusted-LAN publish (Cursor + tunnel-client share one MCP endpoint):
#
#   HELLOZEN_MCP_PUBLISH_HOST=192.168.50.234
#
# Cursor mcp.json:
#   http://192.168.50.234:8790/mcp
#
# tunnel-client hellozen.yaml upstream:
#   http://192.168.50.234:8790/mcp
#
# Do not port-forward TCP 8790. There is no public HelloZen MCP endpoint.
#
# On-demand lifecycle (preferred):
#
#   ./scripts/hellozen-session start
#   ./scripts/hellozen-session status
#   ./scripts/hellozen-session stop
#
# Initial build (Vision: Buildx 0.15.1 — use docker build, not compose build):
#
#   cd /mnt/user/devconcepts/hellozenmcp
#   docker build --pull -t hellozenmcp-hellozen-mcp .
#   docker compose up -d --no-build hellozen-mcp
#
# Manual MCP only (without session wrapper):
#   docker compose start hellozen-mcp
#   curl -fsS http://192.168.50.234:8790/healthz && echo
#   docker compose stop hellozen-mcp
#
# Compose uses restart: "no" — Vision/Docker reboot does not auto-start the connector.
#
# --- Upgrade to v1.1.0 (or newer main) ---
#
#   cd /mnt/user/devconcepts/hellozenmcp
#   ./scripts/hellozen-session stop    # if session was running
#   git fetch origin
#   git checkout v1.1.0                # or: git pull origin main
#
# Add to .env if not already set (use your Vision private LAN IP):
#   HELLOZEN_MCP_PUBLISH_HOST=192.168.50.234
#
# Update tunnel-client hellozen.yaml upstream to match:
#   http://192.168.50.234:8790/mcp
#
# Rebuild image (Vision Buildx 0.15.1 — use docker build, not compose build):
#   docker build --pull -t hellozenmcp-hellozen-mcp .
#   docker compose up -d --no-build hellozen-mcp
#
# Verify:
#   ./scripts/hellozen-session status
#   curl -fsS http://192.168.50.234:8790/healthz && echo
